	column Composite_key =
			
			-- Creating a key to link to the endurance times table
			'Past results'[Sex] & "-" & 'Past results'[AgeGrp] & "-" & 'Past results'[Distance]& "-" & 'Past results'[Stroke]
		lineageTag: 77775509-7bf9-4490-a89c-cdcbc4934e9a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Axis_order_distance
		dataType: string
		lineageTag: e1cc6519-4984-47ff-a13b-8a319b0b61a9
		summarizeBy: none
		sourceColumn: Axis_order_distance

		annotation SummarizationSetBy = Automatic

	column Times = ```
			
			-- Getting the times from the 'Distance' column and that from the 'Results' column in one column. 
			IF(CONTAINSSTRING('Past results'[Result], ":"),
			'Past results'[Result],
			"0" & LEFT('Past results'[Distance], 2) & ":00.00")
			```
		lineageTag: 1246fe8b-cfbb-4888-a666-c922882eba39
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column TotalSeconds =
			IF('Past results'[Times] == BLANK(), BLANK(),
			VAR Raw = TRIM('Past results'[Times])
			VAR ColonPos = FIND(":", Raw)
			VAR DotPos   = FIND(".", Raw)
			
			VAR MinPart  = VALUE(LEFT(Raw, ColonPos - 1))                        -- e.g. 006 → 6
			VAR SecPart  = VALUE(MID(Raw, ColonPos + 1, DotPos - ColonPos - 1)) -- e.g. 36
			VAR CsPart   = VALUE(MID(Raw, DotPos + 1, LEN(Raw)))                 -- e.g. 44 (centiseconds)
			
			RETURN MinPart * 60 + SecPart + CsPart / 100)
		lineageTag: 53d29252-09aa-4c19-8ced-60c4ed12b18b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

