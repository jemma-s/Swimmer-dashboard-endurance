table 'Past results'
	lineageTag: 0b037cd7-2752-4c1a-9959-3033b3f10819

	measure Total_points_pp =
			
			-- Returns overall points
			SUM('March 26 results'[Point])+SUM('Past results'[Point])
		formatString: 0
		lineageTag: cc7e7c8b-72df-423d-8d8a-59b716d6635f

	measure Total_swims_pp =
			
			-- Returns the total amount of swims a swimmer has done
			COUNT('Past results'[Date])+COUNT('March 26 results'[Date])
		formatString: 0
		lineageTag: 3183bf9c-278f-4412-9396-1c43029f2e6c

	measure Total_time_hours_past =
			
			-- Finding the total amount of time one has swam
			SUM('Past results'[TotalSeconds])/3600
		lineageTag: 61f34593-9691-4a83-a57d-4d8e9ca24eb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Overall_hours_swam =
			
			-- Sums both seconds and then converts into hours
			SUM('March 26 results'[TotalSeconds])+SUM('Past results'[TotalSeconds])/3600
		lineageTag: f7cb88cf-9321-47cd-8b76-b0d329d5cc72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

