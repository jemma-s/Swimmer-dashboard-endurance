	column Times = ```
			
			-- Getting the times from the 'Distance' column and that from the 'Results' column in one column. 
			IF(CONTAINSSTRING('March 26 results'[Result], ":"),
			'March 26 results'[Result],
			"0" & LEFT('March 26 results'[Distance], 2) & ":00.00")
			```
		dataType: string
		lineageTag: 891b563a-c31b-46ee-809c-cb79ec77ab52
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column TotalSeconds =
			IF('March 26 results'[Times] == BLANK(), BLANK(),
			VAR Raw = TRIM('March 26 results'[Times])
			VAR ColonPos = FIND(":", Raw)
			VAR DotPos   = FIND(".", Raw)
			
			VAR MinPart  = VALUE(LEFT(Raw, ColonPos - 1))                        -- e.g. 006 → 6
			VAR SecPart  = VALUE(MID(Raw, ColonPos + 1, DotPos - ColonPos - 1)) -- e.g. 36
			VAR CsPart   = VALUE(MID(Raw, DotPos + 1, LEN(Raw)))                 -- e.g. 44 (centiseconds)
			
			RETURN MinPart * 60 + SecPart + CsPart / 100)
		lineageTag: 5c689411-17bd-44a8-a9b5-41c01b8ade66
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Max_points =
			
			-- A conditional comment, returning 'Yes' if the entry recieved top points and 'No' if it didn't
			-- The number of top points is dependent on the distance
			SWITCH(
			    TRUE,
			    'March 26 results'[Distance] == "400m" && 'March 26 results'[Point] = 5, 1,
			    'March 26 results'[Distance] == "800m" && 'March 26 results'[Point] = 10, 1,
			    'March 26 results'[Distance] == "1500m" && 'March 26 results'[Point] = 40, 1,
			    'March 26 results'[Distance] == "30MIN" && 'March 26 results'[Point] = 40, 1,
			    'March 26 results'[Distance] == "45MIN" && 'March 26 results'[Point] = 50, 1,
			    'March 26 results'[Distance] == "60MIN" && 'March 26 results'[Point] = 80, 1,
			    0
			)
		formatString: 0
		lineageTag: 17045475-54e0-4634-8163-2b2d7adb10b8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Axis_order_distance
		dataType: string
		lineageTag: 4d866b87-0f79-43df-9a9c-af387f1ed1b5
		summarizeBy: none
		sourceColumn: Axis_order_distance

		annotation SummarizationSetBy = Automatic

	column Composite_key =
			
			-- Creating a key to link to the endurance times table
			'March 26 results'[Sex] & "-" & 'March 26 results'[AgeGrp] & "-" & 'March 26 results'[Distance]& "-" & 'March 26 results'[Stroke]
		lineageTag: fe38947d-4f4f-43ea-ac92-14a9078a65c4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Point_type =
			
			-- A conditional comment denoting what point type was achieved
			SWITCH(
			    TRUE,
			    'March 26 results'[Distance] == "400m" && 'March 26 results'[Point] = 3, "Middle",
			    'March 26 results'[Distance] == "800m" && 'March 26 results'[Point] = 6, "Middle",
			    'March 26 results'[Distance] == "1500m" && 'March 26 results'[Point] = 30, "Middle",
			    'March 26 results'[Distance] == "30MIN" && 'March 26 results'[Point] = 30, "Middle",
			    'March 26 results'[Distance] == "45MIN" && 'March 26 results'[Point] = 35, "Middle",
			    'March 26 results'[Distance] == "60MIN" && 'March 26 results'[Point] = 60, "Middle",
			    'March 26 results'[Distance] == "400m" && 'March 26 results'[Point] = 5, "Max",
			    'March 26 results'[Distance] == "800m" && 'March 26 results'[Point] = 10, "Max",
			    'March 26 results'[Distance] == "1500m" && 'March 26 results'[Point] = 40, "Max",
			    'March 26 results'[Distance] == "30MIN" && 'March 26 results'[Point] = 40, "Max",
			    'March 26 results'[Distance] == "45MIN" && 'March 26 results'[Point] = 50, "Max",
			    'March 26 results'[Distance] == "60MIN" && 'March 26 results'[Point] = 80, "Max",
			    "Min"
			)
		lineageTag: f4e5feaa-c27b-43d5-b3a4-7de21b8ee9ce
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'March 26 results' = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\jemma\OneDrive\Documents\Somerset\Coding\Swimmer-dashboard\Swimmer-dashboard-endurance\files\E1000-results.xlsx"), null, true),
				    Sheet1_Sheet = Source{[Item="Sheet1",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"MSA ID", Int64.Type}, {"Club", type text}, {"Sex", type text}, {"AgeGrp", type text}, {"Course", type text}, {"Distance", type text}, {"Stroke", type text}, {"Result", type text}, {"Split", type any}, {"Point", Int64.Type}, {"Date", type date}, {"Location", type text}, {"Name", type text}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Changed Type", "Axis_order_distance", each if [Distance] = "400m" then 1 else if [Distance] = "800m" then 2 else if [Distance] = "1500m" then 3 else if [Distance] = "30MIN" then 4 else if [Distance] = "45MIN" then 5 else if [Distance] = "60MIN" then 6 else 0)
				in
				    #"Added Conditional Column"

	annotation PBI_ResultType = Table

