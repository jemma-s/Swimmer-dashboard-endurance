table 'March 26 results'
	lineageTag: 7a48ef2b-657a-4e83-8e89-da4bcaa74c18

	measure Latest_date = CALCULATE(MAX('March 26 results'[Date]))
		formatString: d mmmm
		lineageTag: d72a1773-125f-4d29-a34b-401e2e254859

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MaxPerCategory"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure Total_points =
			
			SUM('March 26 results'[Point])
		formatString: 0
		lineageTag: 6c9abd83-2d40-4d3c-82ec-d7634e802b1f

	measure Rank_overall =
			
			RANKX(ALL('March 26 results'[Name]),
			    [Total_points],
			    ,
			    DESC,
			    DENSE
			    )
		formatString: 0
		lineageTag: de1513a0-6f30-4d04-80c1-58a10b70824a

	measure Rank_gender =
			
			VAR currentGender = SELECTEDVALUE('March 26 results'[Sex])
			RETURN
			RANKX(
			    FILTER(
			        ALL('March 26 results'[Name]),
			        CALCULATE(SELECTEDVALUE('March 26 results'[Sex])) = currentGender
			    ),
			    CALCULATE([Total_points]),
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 01f6c9b6-5b2b-48fe-b563-cc0660219d73

	measure Rank_suffix_overall =
			
			VAR r = [Rank_overall]
			VAR lastDigit = MOD(r, 10)
			VAR lastTwoDigits = MOD(r, 100)
			RETURN
			    FORMAT(r, "0") &
			    SWITCH(
			        TRUE(),
			        lastTwoDigits IN {11, 12, 13}, "th",
			        lastDigit = 1, "st",
			        lastDigit = 2, "nd",
			        lastDigit = 3, "rd",
			        "th"
			    )
		lineageTag: efcae441-6fec-4c34-98b4-0d6fe6f70ba4

	measure Rank_suffix_gender =
			
			VAR r = [Rank_gender]
			VAR lastDigit = MOD(r, 10)
			VAR lastTwoDigits = MOD(r, 100)
			RETURN
			    FORMAT(r, "0") &
			    SWITCH(
			        TRUE(),
			        lastTwoDigits IN {11, 12, 13}, "th",
			        lastDigit = 1, "st",
			        lastDigit = 2, "nd",
			        lastDigit = 3, "rd",
			        "th"
			    )
		lineageTag: 863e9dab-c1a6-4d16-843f-68abb06a43d5

	measure Earliest_time =
			
			-- First time reccorded in the year
			CALCULATE(
			    MIN('March 26 results'[TotalSeconds]),
			    FILTER('March 26 results', 'March 26 results'[Date] = MIN('March 26 results'[Date])
			))
		formatString: 0
		lineageTag: 4612e01e-f444-4162-bc1e-e5eb60bb29e1

	measure Best_time =
			
			-- Best time recorded in the year
			CALCULATE(
			    MIN('March 26 results'[TotalSeconds]))
		formatString: 0
		lineageTag: 424e0c8b-7360-4562-b194-8b2c95256a89

	measure Improvement = [Earliest_time] - [Best_time]
		formatString: 0
		lineageTag: ebaaa8d2-1919-487c-b2cf-e56d294bb73f

	measure Earliest_time_mins =
			
			-- First time reccorded in the year, displayed as a time
			TIME(0, -- hour
			0, -- minutes
			CALCULATE(
			    MIN('March 26 results'[TotalSeconds]),
			    FILTER('March 26 results', 'March 26 results'[Date] = MIN('March 26 results'[Date])
			)))
		formatString: nn:ss
		lineageTag: a353c71b-f085-4bc3-ad95-b331ca5b01f2

		annotation PBI_FormatHint = {"isCustom":true}

	measure Best_time_mins =
			
			-- Best time reccorded in the year, displayed in mins:secs
			TIME(0, -- hour
			0, -- minutes
			MIN('March 26 results'[TotalSeconds])
			)
		formatString: nn:ss
		lineageTag: 5262f26a-191f-4268-8309-ccfb8b04aae5

		annotation PBI_FormatHint = {"isCustom":true}

	measure Best_time_date =
			
			-- Date of the best time swam
			VAR Best_time = [Best_time]
			RETURN
			CALCULATE(
			    MIN('March 26 results'[Date]),
			    FILTER('March 26 results', 'March 26 results'[TotalSeconds] = Best_time)
			)
		formatString: dd mmmm
		lineageTag: ae5243aa-5905-4c34-9742-0530d1e3cc31

		annotation PBI_FormatHint = {"isCustom":true}

	measure First_date =
			
			-- A measure which finds the first date of the row
			MIN('March 26 results'[Date])
		formatString: dd mmmm
		lineageTag: 335e3d19-e129-40fd-83e5-203469e2442e

		annotation PBI_FormatHint = {"isCustom":true}

	measure Max_points_% =
			
			-- The percentage of points that were 'maximum'
			CALCULATE(SUM('March 26 results'[Max_points])/COUNT('March 26 results'[Max_points]))
		formatString: 0%;-0%;0%
		lineageTag: 16a7b5cf-31e9-457b-8314-fe443553b8cf

	measure Improvement_text =
			
			-- This measure is used to come up on the improvements graph if there is no improvement data
			IF(
			    SUMX(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                'March 26 results',
			                'March 26 results'[Distance],
			                'March 26 results'[Stroke]
			            ),
			            "ImprovementCalc", [Improvement]
			        ),
			        [ImprovementCalc]
			    ) > 0,
			    "",
			    "No improvement data found"
			)
		lineageTag: 59c32f9f-2f30-4810-8c23-bc35a59d0637

	measure Average_points =
			
			-- Finding the average amount of points per swimmer
			SUM('March 26 results'[Point])/DISTINCTCOUNT('March 26 results'[Name])
		formatString: 0
		lineageTag: d40709a4-664e-48ef-a013-0748e41596e4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Improvement_per_swimmer =
			
			-- The best improvement by swimmer
			MAXX(
			    CROSSJOIN(
			        FILTERS('March 26 results'[Distance]),
			        FILTERS('March 26 results'[Stroke])
			    ),
			    [Improvement]
			)
		lineageTag: 8f75266e-ffac-4a08-95f6-47427b447627

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_time_hours =
			
			-- Finding the total amount of time one has swam
			SUM('March 26 results'[TotalSeconds])/3600
		formatString: 0
		lineageTag: 26503f59-37f8-4ea7-87f9-f2d19779794b

		annotation PBI_FormatHint = {"isDecimal":true}

