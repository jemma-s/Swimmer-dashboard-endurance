	column Composite_key =
			
			-- Creating a key to link to the current results table
			'E1000 Scoring'[Sex] & "-" & 'E1000 Scoring'[Age group] & "-" & 'E1000 Scoring'[Distance] & "-" & 'E1000 Scoring'[Stroke]
		lineageTag: a6ab6598-d0fb-4e2a-9a51-82d817c9f072
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column TotalSeconds_max_time =
			IF('E1000 Scoring'[Max points time threshold] == BLANK(), BLANK(),
			VAR Raw = TRIM('E1000 Scoring'[Max points time threshold])
			VAR ColonPos = FIND(":", Raw)
			VAR DotPos   = FIND(".", Raw)
			
			VAR MinPart  = VALUE(LEFT(Raw, ColonPos - 1))                        -- e.g. 006 → 6
			VAR SecPart  = VALUE(MID(Raw, ColonPos + 1, DotPos - ColonPos - 1)) -- e.g. 36
			VAR CsPart   = VALUE(MID(Raw, DotPos + 1, LEN(Raw)))                 -- e.g. 44 (centiseconds)
			
			RETURN MinPart * 60 + SecPart + CsPart / 100)
		lineageTag: b1909f04-e9e7-4b0a-b0d5-9d16c038e6ab
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

