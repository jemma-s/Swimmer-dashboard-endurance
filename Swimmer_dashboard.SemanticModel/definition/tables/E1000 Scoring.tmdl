table 'E1000 Scoring'
	lineageTag: db843327-786e-4514-8842-1ce33e0af31c

	measure Top_points_threshold =
			
			-- This combines max points distance threshold and max points time threshold into one measure
			
			VAR CurrentDistance =
			    SELECTEDVALUE( 'March 26 results'[Distance] )
			
			VAR IsDistanceEvent =
			    CurrentDistance = "30MIN" ||
			    CurrentDistance = "45MIN" ||
			    CurrentDistance = "60MIN"
			
			VAR SwimKey =
			    SELECTEDVALUE( 'March 26 results'[Composite_key])
			
			VAR TimeThreshold =
			    CALCULATE(
			        MIN('E1000 Scoring'[Max points time threshold]),
			        FILTER('E1000 Scoring', 'E1000 Scoring'[Composite_key] = SwimKey )
			    )
			
			VAR DistanceThreshold =
			    IFERROR(
			        VALUE( SUBSTITUTE(
			            CALCULATE(
			                MAX( 'E1000 Scoring'[Max points distance threshold]),
			                FILTER( 'E1000 Scoring', 'E1000 Scoring'[Composite_key] = SwimKey )
			            ),
			        "m", "" ) ),
			        BLANK()
			    )
			
			RETURN
			    IF( IsDistanceEvent, DistanceThreshold, TimeThreshold )
		lineageTag: 3a6801a7-1f37-4738-beb5-039260b450ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Improvement Needed' =
			
			-- Finding the improvement needed to reach the top points threshold. Combination of both metres and seconds for tables
			VAR CurrentDistance =
			    SELECTEDVALUE( 'March 26 results'[Distance] )
			
			VAR IsDistanceEvent =
			    CurrentDistance = "30MIN" ||
			    CurrentDistance = "45MIN" ||
			    CurrentDistance = "60MIN"
			
			VAR TopPointsThreshold =
			    IF(
			        IsDistanceEvent,
			        [Top_points_threshold],
			        SELECTEDVALUE( 'E1000 Scoring'[TotalSeconds_max_time])
			    )
			
			VAR CurrentResult =
			    IF(
			        IsDistanceEvent,
			        SELECTEDVALUE( 'March 26 results'[Result] ),
			        SELECTEDVALUE( 'March 26 results'[TotalSeconds] )
			    )
			
			VAR ImprovementNeeded =
			    IF(
			        IsDistanceEvent,
			        TopPointsThreshold - CurrentResult,
			        CurrentResult - TopPointsThreshold
			    )
			
			VAR ImprovementCapped =
			    IF( ImprovementNeeded <= 0, 0, ImprovementNeeded )
			
			VAR Minutes =
			    INT( ImprovementCapped / 60 )
			
			VAR Seconds =
			    ImprovementCapped - ( Minutes * 60 )
			
			VAR SecondsFormatted =
			    IF( Seconds < 10, "0" & FORMAT( Seconds, "0.00" ), FORMAT( Seconds, "0.00" ) )
			
			RETURN
			    IF(
			        IsDistanceEvent,
			        ImprovementCapped & "m",
			        Minutes & ":" & SecondsFormatted
			    )
		lineageTag: 14e06ac0-5c70-4b85-a22a-d1f995a11550

