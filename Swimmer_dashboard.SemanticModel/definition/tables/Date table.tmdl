	column Year = FORMAT('Date table'[Date], "yyyy")
		dataType: string
		lineageTag: ea782a29-c06f-48b3-80d0-0eabe8c5109a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Day_month = FORMAT('Date table'[Date], "mmmm")
		lineageTag: e31828ce-1b61-4985-a15b-a84b45b4817f
		summarizeBy: none
		sortByColumn: Month_num

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition 'Date table' = calculated
		mode: import
		source = CALENDARAUTO()

	annotation PBI_Id = 5529536d5eb1450497a1d7c1a86ba034

