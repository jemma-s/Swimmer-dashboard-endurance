model Model
	culture: en-AU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["March 26 results","E1000 Scoring"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

ref table 'March 26 results'
ref table 'E1000 Scoring'
ref table 'Date table'

ref cultureInfo en-AU

